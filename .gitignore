# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/

# Jupyter Notebook Checkpoints (if working with notebooks/ML)
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 2. Node & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------------------------------------------
# 4. Databases & Runtime State
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
blockscope_investigations.db

# ------------------------------------------------------------------------------
# 5. Machine Learning Models & Heavy Artifacts (Over GitHub's 100MB limit)
# ------------------------------------------------------------------------------
# Uncomment below if you have large generated model weights or dumps:
# *.pkl
# *.joblib
# *.h5
# *.pt
# *.onnx

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
